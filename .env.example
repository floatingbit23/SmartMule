# === SmartMule - Configuración ===
# Copia este archivo como .env y ajusta los valores a tu entorno.

# Carpeta que eMule usa para descargas completadas
INCOMING_PATH=C:\Users\tuUsuario\eMule\Incoming

# Carpeta raíz donde SmartMule organizará los archivos
LIBRARY_PATH=C:\Users\tuUsuario\eMule\SmartMule\Library

# Ruta absoluta a la carpeta del proyecto (donde reside main.py)
PROJECT_PATH=C:\Ruta\Al\Proyecto\SmartMule

# Tiempo de debounce en segundos (para ignorar eventos duplicados de Windows)
DEBOUNCE_SECONDS=3.0

# Tiempo máximo de espera para que eMule libere un archivo (segundos)
FILE_LOCK_TIMEOUT=120

# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Modo de organización (hardlink, move, copy)
# - hardlink: Recomendado. No gasta espacio extra y permite seguir compartiendo en eMule.
# - move: Mueve el archivo (ahorra espacio pero dejas de compartir).
# - copy: Duplica el archivo (ocupa el doble de espacio).
ORGANIZER_MODE=hardlink

# === APIs y Modelos de Lenguaje ===
# Token Bearer de la API v3 de The Movie DataBase
TMDB_BEARER_TOKEN=tu_bearer_token_aqui

# User-Agent requerido por APIs comunitarias (OpenLibrary, MusicBrainz) - Usa tu email
CONTACT_EMAIL_USER_AGENT=smartmule-dev@example.com

# API Key de VirusTotal (Triaje de software malicioso)
VIRUSTOTAL_API_KEY=tu_virustotal_api_key_aqui

# Timeout para solicitudes HTTP a APIs externas (segundos)
API_TIMEOUT=30

# API Key de LM Studio Local Inference Server
LMSTUDIO_API_KEY=tu_lm-studio_api_token

# API Key de Gemini (si USE_LOCAL_LLM=False)
GEMINI_API_KEY=tu_gemini_api_key

# Activar o desactivar el uso de un LLM local.
USE_LOCAL_LLM=True

# === Búsqueda Semántica (Opcional) ===
# Modelo de embeddings multilingüe (ONNX). Cambiar solo si sabes lo que haces.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Cuantización (Quantization) del modelo (para optimizar rendimiento y uso de memoria)
# Opciones: Default (lo que el motor ONNX determine como óptimo para tu hardware), int8, uint8, float32... (depende del modelo)
EMBEDDING_QUANTIZATION=Default  

# === Aplicaciones y Reproductores Preferidos (Opcional) ===

# Define tus aplicaciones favoritas para abrir los archivos directamente desde la CLI.
# Si se dejan en blanco, SmartMule usará la autodetección o las aplicaciones predeterminadas del Sistema Operativo

# EJEMPLO:

# 🎬 Cine y TV / Música (Multimedia)
MEDIA_PLAYER_PATH=C:\Program Files\VideoLAN\VLC\vlc.exe
MEDIA_PLAYER_ARGS=--fullscreen --ontop

# 📚 Libros y Cómics (eBooks / PDFs)
EBOOK_READER_PATH=C:\Program Files\SumatraPDF\SumatraPDF.exe
EBOOK_READER_ARGS=

# 🖼️ Imágenes (Fotos y capturas)
IMAGE_VIEWER_PATH=
IMAGE_VIEWER_ARGS=

# 📄 Documentos (Hojas de cálculo, Ofimática, Notas)
DOCUMENT_EDITOR_PATH=C:\Program Files\Notepad++\notepad++.exe
DOCUMENT_EDITOR_ARGS=

# 📦 Comprimidos (ZIP, RAR, 7Z)
ARCHIVE_MANAGER_PATH=C:\Program Files\WinRAR\WinRAR.exe
ARCHIVE_MANAGER_ARGS=

